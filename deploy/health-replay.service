[Unit]
Description=Crew Health Monitor replay (sends each mission day when the mission clock reaches it)
After=health-api.service
Wants=health-api.service

[Service]
User=SERVICE_USER
WorkingDirectory=PROJECT_DIR
EnvironmentFile=PROJECT_DIR/deploy/env
ExecStart=PROJECT_DIR/.venv/bin/python inputs/replay.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
