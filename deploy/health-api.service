[Unit]
Description=Crew Health Monitor API
After=network.target

[Service]
User=SERVICE_USER
WorkingDirectory=PROJECT_DIR
EnvironmentFile=PROJECT_DIR/deploy/env
# 127.0.0.1: reachable only through nginx (the API has no login)
ExecStart=PROJECT_DIR/.venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
