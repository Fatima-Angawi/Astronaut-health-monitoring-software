# Copy to deploy/env and fill in. deploy/env is not committed (.gitignore).
# The address the UI is served from, so the browser may call the API (no trailing slash).
PUBLIC_ORIGIN=https://YOUR_DOMAIN
# Free key from https://api.nasa.gov. Only needed to refresh the DONKI solar-event data (inputs/donki.py).
NASA_API_KEY=
# 1 = the API runs the engine by itself after new data arrives; 0 = off
ENGINE_AUTORUN=1
