  "_about": "Structured alert rules for the MVP indicators. Thresholds and level mapping are taken from the knowledge base (pipeline columns). value_id must exist in the Values sheet, or be null with a note when the source is not in the sheet yet. 'enabled': false = rule waiting for a source.",
  "_ops": {
    "<, >, <=, >=, ==": "compare metric with threshold",
    "baseline+2sd": "metric above personal baseline + threshold × robust SD (threshold = 2)",
    "below_baseline_by": "window mean of metric below personal baseline by at least threshold",
    "consecutive": "the indicator's yellow rule true on `threshold` sessions in a row",
    "persists": "the indicator's yellow rule true for `window_days` days in a row",
    "and_yellow": "this indicator's yellow AND the indicator named in metric is yellow on the same day",
    "before_critical": "this indicator's orange within 24 h before a critical task (mission_events.critical = 1)",
    "flag": "metric is a 0/1 flag computed by features.py"
  },
